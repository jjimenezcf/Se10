<!DOCTYPE html>
<html lang="es-es">
@{
        // Evalúa si el acceso es anónimo (true) o no (false)
        var accesoAnonimo = (ViewData["AccesoAnonimo"] is bool anon) && anon;
        // Página pública con los estilos del sistema pero sin usuario de conexión (p.e. validar el QR de una factura): no se inicia el entorno
        var paginaPublica = (ViewData["PaginaPublica"] is bool publica) && publica;
}
<head>
    <meta http-equiv="Expires" content="-1">
    <meta http-equiv="Pragma" content="no-cache">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* <link href="manifest.json" rel="manifest" /> *@
    <title>@ViewData["Title"]</title>

    @if (!accesoAnonimo)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css">

        <link rel="stylesheet" href="~/css/PanelDeControl.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/PanelDeControlCabecera.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/PanelDeControlCuerpo.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/PanelDeControlPie.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Formulario.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/ControlesDto.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/SelectorEnModal.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Exportacion.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/EnvioDeCorreos.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Grid.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/ApiDeArchivos.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Expansores.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/CrudHistorial.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/CrudCreacion.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/CrudEdicion.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/CrudBase.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/CrudModal.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/seMenu.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Jerarquia.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Seguridad.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/MenuFlotante.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Agenda.css" type="text/css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/Flujo.css" type="text/css" asp-append-version="true">
        @*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">*@

        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.9.0/moment-with-locales.js"></script>
        @*<script src="~/js/popper.min.js"></script>*@
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js"></script>

        @*<script type="text/javascript" src="https://maps.google.com/maps/api/js"></script>*@
        @if ((ViewData["DatosDeConexion"] as DatosDeConexion).UsarBundle)
        {
            <script src="/js/bundle.js" asp-append-version="true"></script>
        }
        else
        {
            @* la lista de scripts está en ListaDeScripts.cs (la misma con la que Startup genera el bundle) *@
            foreach (var script in MVCSistemaDeElementos.ListaDeScripts.Comunes)
            {
                <script src="@Url.Content($"~/js/{script}")" asp-append-version="true"></script>
            }
        }
    }

    <script>
        @if (!accesoAnonimo)
        {
                @:EntornoSe.InicializarHistorial();
        }
    </script>
</head>

@using ServicioDeDatos

<body class="body-pagina">
    <div class="background-image"></div>
    @RenderBody()

    @if (!accesoAnonimo)
    {
        <script>
            document.documentElement.style.setProperty('--background-opacity', '@CacheDeVariable.LYT_Opacidad.ToString().Replace(",", ".")');
            document.documentElement.style.setProperty('--background-image-url', 'url("@CacheDeVariable.LYT_Imagen_De_Fondo")');
        </script>

        <div id="id-modal-menu" class="modal-menu">
            <div id="id-contenedor-menu" class="menu-contenedor">
            </div>
        </div>

        <div id="id-modal-historial" class="contenedor-modal-de-mensajes">
            <div id="id-contenedor-historial" class="contenido-modal">
                <div id="id-historial-cabecera" class="contenido-cabecera cabecera-de-modal">
                    <span class="rotulo-de-modal">
                        <svg class="icono-de-modal" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z M8 9h8 M8 12h5" /></svg>
                        <h2>Historial de mensajes</h2>
                    </span>
                    <span class="cerrar-de-modal" title="Cerrar" onclick="MensajesSe.CerrarHistorial()">&times;</span>
                </div>
                <div id="id-historial-cuerpo" class="contenido-cuerpo" style="max-height: 30em;">
                    <div id="id-historial-cuerpo.tabla" class="div-tabla cuerpo-datos-tabla table table-striped tabla-historial-mensajes" style="margin-bottom: 0px;">
                        <div id="id-historial-cuerpo.cabecera" class="div-thead thead-historial-mensajes">
                            <div id="id-historial-tabla.cabecera.fila" class="div-tr">
                                <div class="div-th columna-cabecera" propiedad="_mensaje" style="text-align: left; width: auto">
                                    Mensaje
                                </div>
                                <div class="div-th columna-cabecera" propiedad="_fecha" style="text-align: right; width: 5em">
                                    Fecha
                                </div>
                                <div class="div-th columna-cabecera" propiedad="_tipo" style="text-align: center; width: 5em">
                                    Tipo
                                </div>
                                <div class="div-th columna-cabecera" propiedad="_origen" style="text-align: left; width: 20em">
                                    Origen
                                </div>
                            </div>
                        </div>
                        <div id="id-historial-tabla.body" class="div-tbody cuerpo-datos-tbody">
                            <!-- lineas de la clase: cuerpo-datos-tbody-tr-->
                        </div>
                    </div>
                </div>
                <div id="{IdHtml}_pie" class="contenido-modal-pie-menu contenido-modal-pie-derecho">
                    <input type="text" id="id-historial-cuerpo-borrar" class="boton-modal btn btn-secondary" value="Borrar" onclick="MensajesSe.BorrarHistorial()" readonly />                </div>
            </div>
        </div>

        <div id="contenedor-mi-usuario">
        </div>

        <div id="contenedor-subir-certificado">
        </div>

        <div id="contenedor-cambiar-password">
        </div>

        <div id="contenedor-ia">
        </div>
    }
    @RenderSection("Scripts", required: false)

    @if (!accesoAnonimo)
    {
        <script>
            function Ajustar() {
            EntornoSe.AjustarDivs();
            }

            function Inicializar() {
            EntornoSe.IniciarEntorno();
            }

            function Navegar() {
            console.log("location: " + document.location + ", state: " + JSON.stringify(event.state));
            }

            window.onresize = Ajustar;
            window.onhashchange = Navegar;

            // document.addEventListener('DOMContentLoaded', function() {
            //     EntornoSe.IniciarEntorno();
            // });

            document.addEventListener('DOMContentLoaded', function() {
            @if (!accesoAnonimo && !paginaPublica)
            {
                    @:EntornoSe.IniciarEntorno();
            }
            });

        </script>
    }

</body>
</html>




