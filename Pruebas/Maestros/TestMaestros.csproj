<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de integración de Maestros (los de ValidacionesDeReglasDeNegocio) como programa de consola con menú, contra la BD de test -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TestMaestros</AssemblyName>
    <RootNamespace>PruebasDeIntegracion</RootNamespace>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- sólo el framework: Assert, [Test]... los ejecuta MenuDeTests, no un runner de NUnit -->
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- el entorno es el de la aplicación web: su Startup registra el contexto, el mapeador y los gestores -->
    <ProjectReference Include="..\..\SistemaDeElementos\SistemaDeElementos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- la cadena de conexión es la de la aplicación web; el programa sólo deja seguir si la BD es la permitida en config.json -->
    <None Include="..\..\SistemaDeElementos\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- pdf y almacén de claves de TestSignBCSimple -->
    <None Update="circles.pdf;test1234.p12">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- llegan dos BouncyCastle (BouncyCastle.Crypto 1.8 y BouncyCastle.Cryptography 2.x, la de iText) con los mismos tipos:
       TestSignBCSimple usa los de la 2.x, la antigua queda fuera del espacio global con un alias -->
  <Target Name="AliasBouncyCastleAntiguo" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'BouncyCastle.Crypto'">
        <Aliases>BouncyCastleAntiguo</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
