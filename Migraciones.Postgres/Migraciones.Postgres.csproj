<Project Sdk="Microsoft.NET.Sdk">

	<!-- Migraciones de EF Core para PostgreSQL. Las de SQL Server siguen en ..\Migraciones y no se tocan.
	     La carpeta Migrations se genera con:  dotnet ef migrations add InitialCreate  (ver ModeloDeDatos/Postgres/PORTADO_A_POSTGRES.md) -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<NoWarn>$(NoWarn);CS8981</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Servicios\GestorDeElementos\GestorDeElementos.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Packaging" Version="7.3.1" />
		<PackageReference Include="NuGet.Protocol" Version="7.3.1" />
	</ItemGroup>

</Project>
